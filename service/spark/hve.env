# HVE Life OS — Spark runtime environment (loopback-only by default)
# Loaded by: runtime/bin/start-model.sh, runtime/bin/start-hve.sh
# This is the ONLY config for the deployment. No credentials.
#
# B1 — Alpha profile pinning: `hve agent ask` MUST resolve the
# hve-alpha Hermes profile (Qwen3.8-2B-Distill @ 127.0.0.1:8089)
# and never the caller's ambient profile. Setting this lets the
# resolver find <~/.hermes>/profiles/hve-alpha even when HERMES_HOME
# is unset.
export HVE_HERMES_HOME=/home/hans/.hermes/profiles/hve-alpha
export HVE_HERMES_PROFILE=hve-alpha

export HVE_HOME=/home/hans/hve-life-os/data
export HVE_DB_PATH=/home/hans/hve-life-os/data/hve.db
export HVE_KNOWLEDGE_DIR=/home/hans/hve-life-os/data/knowledge
export HVE_REPORTS_DIR=/home/hans/hve-life-os/data/reports
export HVE_BACKUPS_DIR=/home/hans/hve-life-os/data/backups
export HVE_MODEL_PATH=/home/hans/hve-life-os/models/Qwen3.8-2B-Distill-Q4_K_M.gguf
export HVE_MODEL_ENDPOINT=http://127.0.0.1:8089/v1
export HVE_MODEL_CONTEXT=65536
export HVE_MODEL_NAME=Qwen3.8-2B-Distill-Q4_K_M
export HVE_MAX_OUTPUT_TOKENS=1024
export HVE_HTTP_HOST=127.0.0.1
export HVE_HTTP_PORT=8090
export HVE_LAN=0